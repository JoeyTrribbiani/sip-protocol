{
  "name": "dsh-sip-protocol",
  "version": "0.2.0",
  "description": "SIP encryption library as a dsh plugin — XChaCha20-Poly1305 AEAD encrypt/decrypt agent tools plus streaming encrypted file pack/unpack (.sipft artifacts), backed by sip_protocol (Python). Zero-deploy: no service process, tools spawn one-shot Python per call.",
  "type": "module",
  "main": "lib/index.mjs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyTrribbiani/sip-protocol.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "encryption",
    "xchacha20",
    "poly1305",
    "aead",
    "e2ee"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
